                "keys": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "time": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 600
                      },
                      "position": {
                        "$ref": "#/definitions/vector"
                      },
                      "surface": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,64}$"
                      },
                      "yaw": {
                        "type": "number",
                        "minimum": -3600,
                        "maximum": 3600
                      },
                      "rotation": {
                        "$ref": "#/definitions/vector"
                      },
                      "visible": {
                        "type": "boolean"
                      },
                      "interpolation": {
                        "type": "string",
                        "enum": [
                          "linear",
                          "ease",
                          "hold"
                        ]
                      }
                    },
                    "required": [
                      "time",
                      "position"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 100
                },
                "path": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "position": {
                            "$ref": "#/definitions/vector"
                          },
                          "surface": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,64}$"
                          }
                        },
                        "required": [
                          "position"
                        ]
                      },
                      "minItems": 2,
                      "maxItems": 24
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 600
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 120
                    },
                    "navigate": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "points",
                    "duration"
                  ]
                },
                "physics": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "start": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 600
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 12
                    },
                    "velocity": {
                      "$ref": "#/definitions/vector"
                    },
                    "gravity": {
                      "type": "number",
                      "minimum": -40,
                      "maximum": 10
                    },
                    "restitution": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "duration"
                  ]
                }
              },
              "required": [
                "objectId",
                "action"
              ],
              "oneOf": [
                {
                  "required": [
                    "keys"
                  ]
                },
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "physics"
                  ]
                }
              ]
            },
            "minItems": 0,
            "maxItems": 100
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "name": {
                  "type": "string",
