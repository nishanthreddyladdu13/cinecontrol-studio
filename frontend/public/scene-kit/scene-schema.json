  "required": [
    "sceneFormat",
    "id",
    "title",
    "stages"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CineControl scene description 1",
  "definitions": {
    "vector": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "size": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0.01,
        "maximum": 1000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "box",
            "sphere",
            "cylinder",
            "cone",
            "capsule",
            "torus",
            "prism",
            "mesh"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "size": {
          "$ref": "#/definitions/size"
        },
        "position": {
          "$ref": "#/definitions/vector"
        },
        "rotation": {
          "$ref": "#/definitions/vector"
        },
        "color": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metalness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emissive": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "profile": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -0.5,
              "maximum": 0.5
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 64
        },
        "vertices": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -0.5,
              "maximum": 0.5
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 3,
          "maxItems": 256
        },
        "triangles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 1,
          "maxItems": 512
        }
      },
      "required": [
        "shape",
        "name",
        "size",
        "position"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "const": "prism"
              }
            }
          },
          "then": {
            "required": [
              "profile"
            ]
          },
          "else": {
            "not": {
              "required": [
                "profile"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "mesh"
              }
            }
          },
          "then": {
            "required": [
              "vertices",
              "triangles"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "vertices"
                  ]
                },
                {
                  "required": [
                    "triangles"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
