                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "time": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 600
                      },
                      "position": {
                        "$ref": "#/definitions/vector"
                      },
                      "target": {
                        "$ref": "#/definitions/vector"
                      },
